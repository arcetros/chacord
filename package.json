{
    "name": "chacord",
    "version": "1.2.0",
    "description": "A simple Discord bot that allows you to manage challonge tournaments",
    "main": "src/index.ts",
    "scripts": {
        "clean": "rimraf dist",
        "start": "node -r dotenv/config ./dist/index.js",
        "dev": "nodemon src/index.ts",
        "build": "npm run clean && npm run lint && npm run compile",
        "compile": "npx swc src -d dist",
        "lint": "eslint . --ignore-path .gitignore --ext .ts",
        "lint:fix": "eslint . --ignore-path .gitignore --ext .ts --fix",
        "pretty": "prettier --check src/**/*.ts",
        "pretty:write": "prettier --write src/**/*.ts",
        "release": "standard-version"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arcetros/chacord.git"
    },
    "author": "arcetros",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/arcetros/chacord/issues"
    },
    "homepage": "https://github.com/arcetros/chacord#readme",
    "engines": {
        "node": ">=17.5.0",
        "npm": ">=7.0.0"
    },
    "eslintConfig": {
        "parser": "@typescript-eslint/parser",
        "extends": [
            "eslint:recommended",
            "plugin:@typescript-eslint/recommended",
            "prettier"
        ],
        "rules": {
            "@typescript-eslint/no-explicit-any": "off",
            "@typescript-eslint/no-non-null-assertion": "off"
        },
        "plugins": [
            "prettier",
            "@typescript-eslint"
        ],
        "ignorePatterns": [
            "dist/*",
            "index.js"
        ]
    },
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "printWidth": 120,
        "proseWrap": "never"
    },
    "devDependencies": {
        "@swc/cli": "^0.1.62",
        "@swc/core": "^1.3.95",
        "@types/node": "^18.18.14",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-prettier": "^4.2.1",
        "node-fetch": "^3.3.2",
        "nodemon": "^2.0.22",
        "prettier": "^2.8.8",
        "standard-version": "^9.5.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.3.2"
    },
    "dependencies": {
        "consola": "^3.2.3",
        "discord.js": "^14.9.0",
        "dotenv": "^16.0.3",
        "moment": "^2.29.4",
        "rimraf": "^5.0.5"
    }
}
